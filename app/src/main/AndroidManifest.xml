<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
        Starveil skeleton. Permissions are declared here as documentation of intent;
        the skeleton requests nothing at runtime yet. Each permission must be
        justified before use in a real build.
    -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!--
        Package visibility. The per-app screen lists apps with a launcher entry,
        and on Android 11+ queryIntentActivities returns only our own package
        unless the intent is declared here. Without this the list is empty and
        the feature looks broken rather than unpermitted.
    -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <application
        android:name=".StarveilApp"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Starveil">
        <activity
            android:name=".MainActivity"
            android:configChanges="uiMode|orientation|screenSize|screenLayout|density|keyboardHidden"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
            The notification's Disconnect action. Not exported: the broadcast is
            package-scoped by the service that sends it, so only this app can
            deliver it, and nothing outside can stop the tunnel.
        -->
        <receiver
            android:name=".notification.DisconnectReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="com.justnpcx.starveil.action.DISCONNECT" />
            </intent-filter>
        </receiver>

        <!--
            Quick-settings tile. The system binds to it, so it must be exported
            and carry the platform's BIND_QUICK_SETTINGS_TILE permission —
            without the permission any app could bind and drive the tunnel.
            The icon is the kernel module's shield: a tile icon is tinted, so it
            has to be a silhouette, and the notification already ships one.
        -->
        <service
            android:name=".tile.StarveilTileService"
            android:exported="true"
            android:icon="@drawable/ic_notification"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <!--
            Home-screen widget. Not exported: the launcher binds through the
            system, and nothing outside this app should be able to drive it.
        -->
        <receiver
            android:name=".widget.StarveilWidgetReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/starveil_widget_info" />
        </receiver>
    </application>

</manifest>
