<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
        app_name must stay here. net.zetetic:sqlcipher-android ships its own
        strings.xml with app_name="Database" (a leftover from that library's
        sample app), and it wins the resource merge whenever the app does not
        define the name itself — which showed up as "Database" in the VPN
        consent dialog on device.
    -->
    <string name="app_name">Starveil</string>
    <!-- Bottom navigation. Resources, not Kotlin: the tabs are the most-read
         words in the app and were the only ones a translation could not reach. -->
    <string name="nav_home">Home</string>
    <string name="nav_nodes">Nodes</string>
    <string name="nav_rules">Rules</string>
    <string name="nav_logs">Logs</string>
    <string name="nav_settings">Settings</string>


    <!-- Quick-settings tile. The label is the app name; the subtitle is the state. -->
    <string name="tile_connected">Connected</string>
    <string name="tile_disconnected">Disconnected</string>

    <!-- Home-screen widget. -->
    <string name="widget_description">Connection status, with a tap to toggle.</string>
    <string name="widget_connected">Connected</string>
    <string name="widget_disconnected">Disconnected</string>
    <string name="widget_tap_connect">Tap to connect</string>
    <string name="widget_tap_disconnect">Tap to disconnect</string>
    <string name="latency_measured">Latency: %1$d ms</string>
    <string name="latency_no_node">Pick a node first.</string>
    <string name="latency_timeout">No reply from the node within the probe window.</string>
    <string name="latency_unreachable">Could not reach the node — no TCP reply on its port.</string>
    <string name="latency_not_applicable">Not measurable — WireGuard speaks UDP only, and this probe is a TCP handshake.</string>

    <string name="scene_channel_name">Scenes</string>
    <string name="scene_channel_desc">A record of automatic policy switches.</string>
    <string name="scene_applied_title">Scene applied</string>
    <string name="scene_applied_body">%1$s: switched to %2$s.</string>
</resources>
