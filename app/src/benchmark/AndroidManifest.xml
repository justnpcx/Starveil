<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
      The benchmark variant is profileable so the harness can capture method
      traces through the shell. Without it macrobenchmark fails outright with
      "Unable to capture profile", and it is deliberately not in the main
      manifest: a shipped release has no reason to let anything profile it.
    -->
    <application>
        <profileable
            android:shell="true"
            tools:targetApi="29" />

        <!--
          Seeding for the scroll benchmark. Benchmark variant only, and exported
          only there: a release build has no such receiver, so nothing can push
          a thousand rows into a shipped app.
        -->
        <receiver
            android:name=".benchmark.SeedReceiver"
            android:exported="true" />

        <!--
          The chaos fixture. LabNodeReceiver writes one real test node (host,
          port and password arrive as broadcast extras, never from the repo);
          ChaosStateReceiver subscribes to the kernel's state flow and writes
          its transitions with elapsedRealtime so the harness can measure a
          drop from the inside. Both exist only in the benchmark variant.
        -->
        <receiver
            android:name=".benchmark.LabNodeReceiver"
            android:exported="true" />
        <receiver
            android:name=".benchmark.ChaosStateReceiver"
            android:exported="true" />
    </application>
</manifest>
